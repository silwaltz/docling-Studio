# =============================================================================
# Docling Studio — Air-gap production .env (SINGLE-MACHINE CO-LOCATED vLLM)
#
# Stack: vllm + document-parser + frontend on one Linux host with NVIDIA GPU.
# Backend talks to vLLM via the shared compose network (DNS name `vllm`).
#
# Required fields are marked with <ANGLE_BRACKETS>. Leave others at default.
# =============================================================================

# --- vLLM (co-located, on the same compose network) --------------------------
# Backend reaches vLLM via in-network DNS — no host port needed.
OPENAI_BASE_URL=http://vllm:8000/v1

# VLM endpoint — same vLLM, same model, same port.
VLM_OPENAI_URL=http://vllm:8000/v1/chat/completions

# Model alias served by vLLM — MUST equal "qwen3-vl:8b-instruct" exactly.
# (The vLLM image bakes `--served-model-name=qwen3-vl:8b-instruct`.)
CHAT_MODEL_ID=qwen3-vl:8b-instruct

# Use OpenAI-compat mode (do NOT change to "ollama" — there is no Ollama here).
CHAT_PROVIDER=openai

# vLLM does not require a key by default; leave blank unless your operator set one.
OPENAI_API_KEY=

# --- Docling model artifacts (baked into the backend image, do not change) ---
DOCLING_ARTIFACTS_PATH=/opt/docling/models

# --- Deployment settings ------------------------------------------------------
# Allowed CORS origins; set to the URL your browser will use.
CORS_ORIGINS=http://localhost:3000

# Max upload size in MB (0 = unlimited).
MAX_FILE_SIZE_MB=50

# Per-conversion timeout in seconds.
CONVERSION_TIMEOUT=3600

# Fernet key for store-credential encryption. Generate as shown below.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ONLY required if you later configure a per-store password (Neo4j /
# OpenSearch) via the UI. For the minimal stack (no ingestion), this can
# be left blank — the backend boots fine as long as no `stores` row holds
# a `connection_password_sealed` value.
#
# If you ever set it: must stay stable across redeployments; rotating it
# invalidates all previously sealed passwords.
# STORE_SECRET_KEY=

# --- VLM settings ------------------------------------------------------------
# Backend enum name stays "ollama" for compatibility; routing is via VLM_OPENAI_URL.
VLM_BACKEND=ollama
VLM_OLLAMA_MODEL=qwen3-vl:8b-instruct

# --- Ingestion profile (LEFT EMPTY for this minimal setup) -------------------
# OPENSEARCH_URL=http://opensearch:9200
# EMBEDDING_URL=http://embedding:8001
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=<SET_A_REAL_PASSWORD_HERE>
# EMBEDDING_MODEL=all-MiniLM-L6-v2